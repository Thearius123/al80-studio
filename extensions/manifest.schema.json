{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://al80-studio.dev/schemas/extension-manifest-v1.json",
  "title": "AL80 Studio Extension Manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "kind",
    "description",
    "requires",
    "safety"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "runtime-feature",
        "firmware-effect",
        "lcd-widget",
        "profile"
      ]
    },
    "description": {
      "type": "string"
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "firmwareMode",
        "capabilities"
      ],
      "properties": {
        "firmwareMode": {
          "enum": [
            "stock",
            "extended",
            "any"
          ]
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "matrix_scan",
              "rgb_runtime",
              "overlay",
              "lcd_osd",
              "audio_watch",
              "profiles"
            ]
          }
        }
      }
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enableCommand": {
          "type": "string"
        },
        "disableCommand": {
          "type": "string"
        },
        "stateField": {
          "enum": [
            "overlayEnabled",
            "rgbCoreEnabled"
          ]
        }
      }
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "kind",
          "runtimeBinding"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "range",
              "toggle",
              "select"
            ]
          },
          "runtimeBinding": {
            "enum": [
              "unavailable",
              "future"
            ]
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "step": {
            "type": "number"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "firmwareFlash",
        "eepromWrite",
        "persistentLcdWrite"
      ],
      "properties": {
        "firmwareFlash": {
          "type": "boolean"
        },
        "eepromWrite": {
          "type": "boolean"
        },
        "persistentLcdWrite": {
          "type": "boolean"
        }
      }
    }
  }
}
